---
import Layout from '@/layouts/Layout/Layout.astro';
import { getCategories } from '@/utils/getPostInfo';
const entries = getCategories();
---
<Layout title="分类" description="按分类浏览文章"><section style="padding:2rem;background:white;border-radius:1rem"><h1>分类</h1><ul style="line-height:2.5">{entries.map(item => { const name = Array.isArray(item) ? item[0] : item.title; const count = Array.isArray(item) ? item[1] : item.count; return <li><a href={`/categories/${name}/`}>{name} · {count}</a></li>; })}</ul></section></Layout>
